<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/souenergy/notifications/mine" method="GET">
        <service class="SouEnergy\Notification\Api\NotificationRepositoryInterface" method="getMyNotifications"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <route url="/V1/souenergy/notifications/mine/read/:entityId" method="PUT">
        <service class="SouEnergy\Notification\Api\NotificationRepositoryInterface" method="markAsRead"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
</routes>
