<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Backend:etc/menu.xsd">
    <menu>
        <!-- 1. Menu Direto: Gerenciar Usuários -->
        <add id="SouEnergy_Notification::customers"
             title="Gerenciar Usuários"
             module="SouEnergy_Notification"
             sortOrder="10"
             action="souenergy_notification/customer/index"
             resource="Magento_Customer::customer"/>

        <!-- 2. Menu Direto: Gerenciar Notificações -->
        <add id="SouEnergy_Notification::notifications"
             title="Gerenciar Notificações"
             module="SouEnergy_Notification"
             sortOrder="20"
             action="souenergy_notification/notification/index"
             resource="SouEnergy_Notification::notifications"/>

        <!-- 3. Menu Direto: Gerenciar Política de Privacidade -->
        <add id="SouEnergy_Notification::terms"
             title="Gerenciar Política de Privacidade"
             module="SouEnergy_Notification"
             sortOrder="30"
             action="souenergy_notification/terms/index"
             resource="SouEnergy_Notification::notifications"/>

        <!-- Ocultação de menus nativos não utilizados -->
        <remove id="Magento_Backend::dashboard"/>
        <remove id="Magento_Sales::sales"/>
        <remove id="Magento_Catalog::catalog"/>
        <remove id="Magento_Customer::customer"/>
        <remove id="Magento_Backend::marketing"/>
        <remove id="Magento_Backend::content"/>
        <remove id="Magento_Reports::report"/>
        <remove id="Magento_Backend::stores"/>
        <remove id="Magento_Backend::system"/>
        <remove id="Magento_Marketplace::partners"/>
    </menu>
</config>
