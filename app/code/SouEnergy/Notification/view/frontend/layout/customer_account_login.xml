<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Remove o título principal superior "Customer Login" -->
        <referenceBlock name="page.main.title" remove="true"/>

        <!-- Remove o bloco da coluna "Novos Clientes" -->
        <referenceBlock name="customer.new" remove="true"/>

        <!-- Customiza o template do formulário de login para layout centralizado com label "Login" -->
        <referenceBlock name="customer_form_login" template="SouEnergy_Notification::form/login.phtml"/>
    </body>
</page>
