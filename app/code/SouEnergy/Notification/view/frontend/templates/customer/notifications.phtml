<?php
/** @var \SouEnergy\Notification\Block\Customer\NotificationList $block */
$notifications = $block->getNotifications();
?>
<div class="souenergy-notifications-wrapper">
    <div class="souenergy-notifications-header">
        <h2><?= $block->escapeHtml(__('Minhas Notificações')) ?></h2>
        <span class="souenergy-notifications-total">
            Total: <?= count($notifications) ?>
        </span>
    </div>

    <?php if (empty($notifications)): ?>
        <div class="souenergy-notifications-empty">
            <p><?= $block->escapeHtml(__('Você não possui notificações no momento.')) ?></p>
        </div>
    <?php else: ?>
        <div class="souenergy-notifications-list">
            <?php foreach ($notifications as $notification): ?>
                <?php $isRead = $notification->getIsRead(); ?>
                <div class="souenergy-notification-card <?= $isRead ? 'is-read' : 'is-unread' ?>">
                    <div class="souenergy-notification-card__top">
                        <div class="souenergy-notification-card__title-wrap">
                            <h3><?= $block->escapeHtml($notification->getTitle()) ?></h3>
                            <?php if (!$isRead): ?>
                                <span class="souenergy-notification-badge-new">Nova</span>
                            <?php endif; ?>
                        </div>
                        <span class="souenergy-notification-card__date">
                            <?= $block->escapeHtml($notification->getCreatedAt()) ?>
                        </span>
                    </div>

                    <p class="souenergy-notification-card__message">
                        <?= nl2br($block->escapeHtml($notification->getMessage())) ?>
                    </p>

                    <div class="souenergy-notification-card__actions">
                        <?php if ($notification->getActionUrl()): ?>
                            <?php
                                $actionUrl = $notification->getActionUrl();
                                if (!preg_match('~^(?:f|ht)tps?://~i', $actionUrl)) {
                                    $actionUrl = $block->getUrl(ltrim($actionUrl, '/'));
                                }
                                $btnLabel = $notification->getActionLabel() ?: 'Acessar';
                            ?>
                            <a href="<?= $block->escapeUrl($actionUrl) ?>" class="souenergy-notification-action-btn">
                                <?= $block->escapeHtml($btnLabel) ?>
                            </a>
                        <?php endif; ?>

                        <?php if (!$isRead): ?>
                            <a href="<?= $block->escapeUrl($block->getMarkAsReadUrl((int)$notification->getEntityId())) ?>"
                               class="souenergy-notification-read-btn">
                                Marcar como lida
                            </a>
                        <?php else: ?>
                            <span class="souenergy-notification-read-status">Lida</span>
                        <?php endif; ?>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</div>
