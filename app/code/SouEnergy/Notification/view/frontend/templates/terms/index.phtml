<?php
/** @var \Magento\Framework\View\Element\Template $block */
$acceptUrl = $block->getUrl('souenergy/terms/accept');
$customerSession = \Magento\Framework\App\ObjectManager::getInstance()->get(\Magento\Customer\Model\Session::class);
$termsConfig = \Magento\Framework\App\ObjectManager::getInstance()->get(\SouEnergy\Notification\Model\TermsConfig::class);
$currentSystemVersion = $termsConfig->getCurrentVersion();

$isLoggedIn = $customerSession->isLoggedIn();
$userTermsVersion = null;
$userTermsAcceptedAt = null;

if ($isLoggedIn) {
    $customerRepository = \Magento\Framework\App\ObjectManager::getInstance()->get(\Magento\Customer\Api\CustomerRepositoryInterface::class);
    try {
        $customerData = $customerRepository->getById($customerSession->getCustomerId());
        $termsVersionAttr = $customerData->getCustomAttribute('terms_version');
        $termsAcceptedAtAttr = $customerData->getCustomAttribute('terms_accepted_at');
        $userTermsVersion = $termsVersionAttr ? $termsVersionAttr->getValue() : null;
        $userTermsAcceptedAt = $termsAcceptedAtAttr ? $termsAcceptedAtAttr->getValue() : null;
    } catch (\Exception $e) {
        // Fallback
    }
}

$isUpdated = ($isLoggedIn && $userTermsVersion === $currentSystemVersion);
?>
