            <p style="color: #64748b; font-size: 14px; margin: 0;">Versão Vigente: <strong><?= $block->escapeHtml($currentSystemVersion) ?></strong> | Revisão: <?= date('d/m/Y') ?></p>
        </div>
        <?php if ($isUpdated): ?>
            <div style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #047857; padding: 8px 16px; border-radius: 20px; font-weight: 700; font-size: 13px; display: flex; align-items: center; gap: 6px;">
                <span>✓</span> Política Aceita (<?= $block->escapeHtml($currentSystemVersion) ?>)
            </div>
        <?php elseif ($isLoggedIn && $userTermsVersion): ?>
            <div style="background: #fffbeb; border: 1px solid #fde68a; color: #b45309; padding: 8px 16px; border-radius: 20px; font-weight: 700; font-size: 13px; display: flex; align-items: center; gap: 6px;">
