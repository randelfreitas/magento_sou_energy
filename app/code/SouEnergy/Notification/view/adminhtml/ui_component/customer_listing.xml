<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <columns name="customer_columns">
        <column name="terms_version" class="SouEnergy\Notification\Ui\Component\Listing\Column\TermsStatus" sortOrder="85">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="bodyTmpl" xsi:type="string">ui/grid/cells/html</item>
                    <item name="sortable" xsi:type="boolean">true</item>
                    <item name="filter" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Política de Privacidade</item>
                </item>
            </argument>
        </column>
        <column name="terms_accepted_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="86">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Data Aceite Política</label>
            </settings>
        </column>
    </columns>
</listing>
